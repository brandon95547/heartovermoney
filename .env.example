# Copy to .env.local for local development.
DATABASE_URL=postgres://hom:hom@localhost:5434/heartovermoney
# Signs the session cookie: `openssl rand -base64 32`.
SESSION_SECRET=
# The public address, used in QR codes on certificates.
SITE_URL=http://localhost:3100
# Email (password resets, Contact messages). Without SMTP_URL, emails go to the server log.
SMTP_URL=
MAIL_FROM=Heart Over Money <no-reply@heartovermoney.com>
# Where Contact messages are sent.
CONTACT_EMAIL=
